    <string name="tutorial_aim_title">Aim with your finger</string>
    <string name="tutorial_aim_body">Touch the field and drag. The frog follows your finger. Release to shoot.</string>
    <string name="tutorial_choose_title">Choose the right marble</string>
    <string name="tutorial_choose_body">The marble in the frog\'s mouth is the loaded shot. NEXT swaps it with the upcoming marble.</string>
    <string name="tutorial_match_title">Make matches</string>
    <string name="tutorial_match_body">Hit a group of three or more marbles of the same color. The front segment rolls backward while the far side stays still.</string>
    <string name="tutorial_boosters_title">Use boosters</string>
    <string name="tutorial_boosters_body">Slow Time gives you room to aim. Bomb clears a chain segment. Color Change selects the most common chain color. Reverse moves the chain backward briefly.</string>
    <string name="tutorial_track_title">Watch the track</string>
    <string name="tutorial_track_body">Mud slows the chain, ice speeds it up, and rocks mark hazardous sections. Track layouts change between level groups.</string>
