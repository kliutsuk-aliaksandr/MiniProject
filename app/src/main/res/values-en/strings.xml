    <string name="privacy_line_1">Marble Frog works offline. No account or network access is needed.</string>
    <string name="privacy_line_2">The game does not collect, transmit or share personal data.</string>
    <string name="privacy_line_3">No ads, analytics SDKs or server sync are included.</string>
    <string name="privacy_line_4">Best score, saved game, level stars, language and settings</string>
    <string name="privacy_line_5">are stored locally on this device with Android preferences.</string>
    <string name="privacy_line_6">Cloud backup and device transfer of these preferences are disabled.</string>
    <string name="privacy_line_7">Local data can be removed in Android app settings or by uninstalling.</string>
    <string name="privacy_line_8">Support: alex.kliutsuk@gmail.com</string>
